# infra/.env 로 복사해서 쓴다. 비워 두면 docker-compose.yml 의 기본값을 쓴다.

# Qa = GM API·Swagger 켜짐, Production = 꺼짐
SERVER_ENVIRONMENT=Qa
SERVER_PORT=8080

# JWT 서명 키 (32자 이상). 팀 공용 QA 서버라면 꼭 바꾼다.
JWT_KEY=local-qa-signing-key-change-me-0123456789
# 어드민 API·백오피스 키(16자 이상). QA 환경에서만 쓰인다.
ADMIN_KEY=local-qa-admin-key-change-me

DB_PASSWORD=ashveil
DB_PORT=15432
